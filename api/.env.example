# --- Server ---
PORT=8000
# development | production | test (production บังคับตั้งค่าเมล ดู Mail ด้านล่าง)
NODE_ENV=development
# ฐานของลิงก์ที่ส่งไปในอีเมล ต้องไม่มี / ปิดท้าย
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# --- JWT ---
# อย่างน้อย 32 ตัวอักษร สร้าง: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
# อายุ access token (วินาที) สั้นไว้ เว็บต่ออายุให้เองด้วย refresh token — 900 = 15 นาที
# access token เพิกถอนกลางคันไม่ได้ ยิ่งยาว ยิ่งเป็นช่วงที่ token หลุดยังใช้ได้
ACCESS_TOKEN_EXPIRES_IN=900
# อายุ refresh token (วินาที) = ไม่ได้เข้าใช้นานเท่านี้ต้องล็อกอินใหม่ — 2592000 = 30 วัน
REFRESH_TOKEN_EXPIRES_IN=2592000

# --- Google login (ไม่ใส่ก็ได้ = ปิดล็อกอินด้วย Google) ---
# ต้องเป็น client id ตัวเดียวกับที่เว็บใช้ ไม่งั้น verifyIdToken จะไม่ผ่าน
GOOGLE_CLIENT_ID=

# --- Mail (Brevo HTTP API) ---
# ส่งผ่าน HTTP API ไม่ใช่ SMTP เพราะโฮสต์ส่วนใหญ่ (Railway, Render) ปิด outbound SMTP
# dev: ไม่ใส่ BREVO_API_KEY = พิมพ์อีเมลลง console แทนการส่งจริง
# production: ต้องมีทั้ง BREVO_API_KEY และ MAIL_FROM ไม่งั้น API ไม่ยอมเริ่ม
# ขอ key ฟรีได้ที่ https://app.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=
# ต้อง verify เป็น sender ใน Brevo ก่อน ไม่งั้น Brevo ตอบ 400
MAIL_FROM=
MAIL_FROM_NAME="My App"

# --- Security ---
# ใครส่ง X-Forwarded-For มาแล้วเชื่อได้ (ใช้หา IP จริงของผู้ใช้สำหรับ rate limit)
# dev: loopback (เว็บกับ API เครื่องเดียวกัน) / production: IP หรือ subnet ของ server เว็บ
TRUST_PROXY=loopback
# รหัสลับร่วมกับเว็บ (ค่าเดียวกันทั้งสองฝั่ง อย่างน้อย 32 ตัว) — production ควรตั้ง
# API จะเชื่อ IP ของผู้ใช้ที่เว็บส่งมา (X-Client-IP) ตอน dev ไม่ต้องตั้ง
INTERNAL_API_SECRET=

# --- Seed (pnpm db:seed) ---
# สร้าง/อัปเดตบัญชีแอดมินคนแรก รหัสผ่านต้องผ่านกฎเดียวกับตอนสมัคร
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# URL ของ API (NestJS) — เว็บเรียกจากฝั่ง server เท่านั้น เบราว์เซอร์ไม่เห็น
API_URL=http://localhost:8000

# คีย์เข้ารหัสคุกกี้ session ของ next-auth สร้าง: pnpm dlx auth secret
# หรือ node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# URL จริงของเว็บ (เช่น https://app.example.com) — production ต้องตั้ง
# ไม่ตั้ง next-auth จะปฏิเสธ session ทุกอัน (UntrustedHost) ตอน dev ไม่ต้องตั้ง
# AUTH_URL=https://app.example.com

# --- Google login (ไม่ใส่ทั้งคู่ = ซ่อนปุ่ม Google) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID ต้องเป็นตัวเดียวกับที่ API ใช้
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# รหัสลับร่วมกับ API (ค่าเดียวกับ INTERNAL_API_SECRET ของ API) — production ควรตั้ง ตอน dev ไม่ต้อง
INTERNAL_API_SECRET=
